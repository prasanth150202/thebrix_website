# Powers /api/chat: both the topic classifier and the retrieval-augmented
# fallback call OpenRouter. Without it the launcher still renders but every
# question falls through to the support-email reply.
OPENROUTER_API_KEY=sk-or-v1-...

# Database. admin/setup.php writes includes/config.php instead on hosts
# where that file can be created; whichever exists is used, config.php first.
BRIX_DB_HOST=localhost
BRIX_DB_PORT=3306
BRIX_DB_NAME=
BRIX_DB_USER=
BRIX_DB_PASS=
