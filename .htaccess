# ---------------------------------------------------------------
# Brix website - routing
#
# URLs are extensionless: /pricing, /blog, /blog-cart-upsell-examples.
#
# Every address that was previously live as a .html file still works;
# it issues a permanent redirect to the extensionless form. That is
# what preserves the existing search rankings, so the redirects below
# must not be removed.
# ---------------------------------------------------------------

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /api/ is served by the Node deployment, not PHP. Leave it entirely
  # alone so nothing here can change how it behaves.
  RewriteRule ^api/ - [L]

  # ----- 1. permanent redirects for the old addresses -----
  # Matched against the literal request line, so these only fire for a
  # real inbound request and never for the internal rewrites below.

  # Articles are nested now: /blog/cart-upsell-examples rather than
  # /blog-cart-upsell-examples. Both older forms of every article address
  # are redirected here, and the .html form goes straight to the final
  # address rather than through the flat one, so no visitor and no
  # crawler is ever sent through two redirects to read one page.
  RewriteCond %{THE_REQUEST} "\s/blog-[^?\s]+\.html[?\s]" [NC]
  RewriteRule ^blog-([a-z0-9-]+)\.html$ /blog/$1 [R=301,L]

  RewriteCond %{THE_REQUEST} "\s/case-study-[^?\s]+\.html[?\s]" [NC]
  RewriteRule ^case-study-([a-z0-9-]+)\.html$ /case-study/$1 [R=301,L]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} "\s/index\.html[?\s]" [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # /anything.html -> /anything
  RewriteCond %{THE_REQUEST} "\s/([^?\s]+)\.html[?\s]" [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # The flat addresses these pages carried between the CMS migration and
  # the move to nested URLs.
  RewriteRule ^blog-([a-z0-9-]+)/?$ /blog/$1 [R=301,L]
  RewriteRule ^case-study-([a-z0-9-]+)/?$ /case-study/$1 [R=301,L]

  # ----- 2. things that must be served as they are -----

  # sitemap.xml is generated from the database.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # The newsletter endpoint was renamed to /memo because ad blockers
  # cancel requests to paths containing "newsletter". A browser holding
  # a cached copy of the older main.js still posts to the old address,
  # so keep it working rather than dropping those signups.
  RewriteRule ^newsletter-subscribe\.php$ memo.php [L]

  # Real files and directories (css, js, images, /admin/) win.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----- 3. internal routing -----

  # Articles come out of the posts table, keyed by the slug stored there,
  # which is still the old filename stem. The address drops the prefix
  # into a path segment, so /blog/cart-upsell-examples is put back
  # together as the slug blog-cart-upsell-examples before the lookup.
  RewriteRule ^blog/([a-z0-9-]+)/?$ article.php?slug=blog-$1 [L,QSA]
  RewriteRule ^case-study/([a-z0-9-]+)/?$ article.php?slug=case-study-$1 [L,QSA]

  # Ordinary pages: /pricing -> pricing.php, but only when that file
  # actually exists, so a genuinely missing page still 404s.
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?i:md)$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
</IfModule>

# The credentials file is never served.
<FilesMatch "^(config\.php|\.env)$">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.php
